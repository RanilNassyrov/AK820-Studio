+
+/* HOST_COLORS -- every key shows the color the computer sent for it.
+ *
+ * The buffer is filled by the raw-HID channel 0x14 (hid_protocol.c); this only
+ * paints it, scaled by the board's brightness. If the host goes quiet for 2 s
+ * the keys go dark, so a closed program cannot leave a frozen picture behind.
+ */
+RGB_MATRIX_EFFECT(HOST_COLORS)
+
+#ifdef RGB_MATRIX_CUSTOM_EFFECT_IMPLS
+
+extern uint8_t  host_colors[RGB_MATRIX_LED_COUNT][3];
+extern uint32_t host_colors_at;
+
+static bool HOST_COLORS(effect_params_t* params) {
+    RGB_MATRIX_USE_LIMITS(led_min, led_max);
+    bool    alive = timer_elapsed32(host_colors_at) < 2000;
+    uint8_t v     = rgb_matrix_config.hsv.v;
+    for (uint8_t i = led_min; i < led_max; i++) {
+        RGB_MATRIX_TEST_LED_FLAGS();
+        if (alive) {
+            rgb_matrix_set_color(i, scale8(host_colors[i][0], v), scale8(host_colors[i][1], v), scale8(host_colors[i][2], v));
+        } else {
+            rgb_matrix_set_color(i, 0, 0, 0);
+        }
+    }
+    return rgb_matrix_check_finished_leds(led_max);
+}
+
+#endif // RGB_MATRIX_CUSTOM_EFFECT_IMPLS
