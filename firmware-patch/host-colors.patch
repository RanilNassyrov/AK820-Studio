+/* BREATHE -- the whole board in the chosen colour, to a full peak. */
+RGB_MATRIX_EFFECT(BREATHE)
+
+#ifdef RGB_MATRIX_CUSTOM_EFFECT_IMPLS
+
+static bool BREATHE(effect_params_t* params) {
+    RGB_MATRIX_USE_LIMITS(led_min, led_max);
+    uint8_t phase = (uint8_t)rgb_speed_phase(g_rgb_timer, rgb_speed_rate(&RGB_SPEED_BREATHE, rgb_matrix_config.speed));
+    uint8_t k     = qadd8(scale8(sin8(phase), 235), 20);
+    rgb_t   c     = rgb_matrix_hsv_to_rgb(rgb_matrix_config.hsv);
+    for (uint8_t i = led_min; i < led_max; i++) {
+        RGB_MATRIX_TEST_LED_FLAGS();
+        fx_set(i, c, k);
+    }
+    return rgb_matrix_check_finished_leds(led_max);
+}
+
+#endif // RGB_MATRIX_CUSTOM_EFFECT_IMPLS
+
+/* KEY_COLORS -- every key its own colour, from the palette the program paints
+ * (hid_protocol.c, channel 0x15). It lives on the keyboard, so it works wireless. */
+RGB_MATRIX_EFFECT(KEY_COLORS)
+
+#ifdef RGB_MATRIX_CUSTOM_EFFECT_IMPLS
+
+extern uint8_t key_palette[RGB_MATRIX_LED_COUNT][3];
+
+static bool KEY_COLORS(effect_params_t* params) {
+    RGB_MATRIX_USE_LIMITS(led_min, led_max);
+    uint8_t k = fx_level();
+    for (uint8_t i = led_min; i < led_max; i++) {
+        RGB_MATRIX_TEST_LED_FLAGS();
+        rgb_matrix_set_color(i, scale8(key_palette[i][0], k), scale8(key_palette[i][1], k), scale8(key_palette[i][2], k));
+    }
+    return rgb_matrix_check_finished_leds(led_max);
+}
+
+#endif // RGB_MATRIX_CUSTOM_EFFECT_IMPLS
+
+/* REACTIVE -- a faint glow of the chosen colour, and each pressed key flares to
+ * full and falls back. RIPPLE -- each press sends a ring across the board that
+ * walks the hues as it spreads. Both read QMK's last-hit tracker, the 8 newest
+ * presses. Distance is the octagon approximation: no root, 648 times a frame. */
+RGB_MATRIX_EFFECT(REACTIVE)
+RGB_MATRIX_EFFECT(RIPPLE)
+
+#ifdef RGB_MATRIX_CUSTOM_EFFECT_IMPLS
+
+#    define FX_GLOW 28u
+#    define RIPPLE_WIDTH 28u
+
+static bool REACTIVE(effect_params_t* params) {
+    RGB_MATRIX_USE_LIMITS(led_min, led_max);
+    uint8_t rate = 2 + (rgb_matrix_config.speed >> 5);   /* a flare in 1 s to 0.25 s */
+    rgb_t   c    = rgb_matrix_hsv_to_rgb(rgb_matrix_config.hsv);
+    for (uint8_t i = led_min; i < led_max; i++) {
+        RGB_MATRIX_TEST_LED_FLAGS();
+        uint8_t k = FX_GLOW;
+        for (uint8_t j = 0; j < g_last_hit_tracker.count; j++) {
+            if (g_last_hit_tracker.index[j] != i) continue;
+            uint32_t gone = ((uint32_t)g_last_hit_tracker.tick[j] * rate) >> 3;
+            if (gone < 255 && 255 - gone > k) k = 255 - gone;
+        }
+        fx_set(i, c, k);
+    }
+    return rgb_matrix_check_finished_leds(led_max);
+}
+
+static bool RIPPLE(effect_params_t* params) {
+    RGB_MATRIX_USE_LIMITS(led_min, led_max);
+    uint8_t rate = 3 + (rgb_matrix_config.speed >> 5);   /* a ring across the board in 1.2 s to 0.35 s */
+    rgb_t   glow = rgb_matrix_hsv_to_rgb(rgb_matrix_config.hsv);
+    for (uint8_t i = led_min; i < led_max; i++) {
+        RGB_MATRIX_TEST_LED_FLAGS();
+        uint8_t k = 0, hue = 0;
+        for (uint8_t j = 0; j < g_last_hit_tracker.count; j++) {
+            uint32_t radius = ((uint32_t)g_last_hit_tracker.tick[j] * rate) >> 4;
+            if (radius >= 250) continue;
+            int16_t  dx = (int16_t)g_led_config.point[i].x - g_last_hit_tracker.x[j];
+            int16_t  dy = (int16_t)g_led_config.point[i].y - g_last_hit_tracker.y[j];
+            uint16_t ax = dx < 0 ? -dx : dx, ay = dy < 0 ? -dy : dy;
+            uint16_t d   = ax > ay ? ax + (ay >> 1) : ay + (ax >> 1);
+            uint16_t gap = d > radius ? d - radius : radius - d;
+            if (gap >= RIPPLE_WIDTH) continue;
+            uint8_t w = scale8((uint8_t)((RIPPLE_WIDTH - gap) * 9u), (uint8_t)(255u - radius));
+            if (w > k) {
+                k   = w;
+                hue = rgb_matrix_config.hsv.h + (uint8_t)radius;
+            }
+        }
+        if (k > FX_GLOW) {
+            hsv_t hsv = {hue, 255, rgb_matrix_config.hsv.v};
+            fx_set(i, rgb_matrix_hsv_to_rgb(hsv), k);
+        } else {
+            fx_set(i, glow, FX_GLOW);
+        }
+    }
+    return rgb_matrix_check_finished_leds(led_max);
+}
+
+#endif // RGB_MATRIX_CUSTOM_EFFECT_IMPLS
+
+/* CODE_RAIN -- bright heads fall down the columns and leave a fading tail in the
+ * chosen colour. Matrix rows and columns are the grid here, so a drop follows
+ * the real keys. */
+RGB_MATRIX_EFFECT(CODE_RAIN)
+
+#ifdef RGB_MATRIX_CUSTOM_EFFECT_IMPLS
+
+static bool CODE_RAIN(effect_params_t* params) {
+    uint8_t *light = fx_mem, *head = fx_mem + RGB_MATRIX_LED_COUNT;   /* a column's drop in 1/16 rows, 0 = none */
+
+    fx_start(params);
+    RGB_MATRIX_USE_LIMITS(led_min, led_max);
+
+    if (params->iter == 0) {
+        uint8_t step = 1 + (rgb_matrix_config.speed >> 6);
+        for (uint8_t i = 0; i < RGB_MATRIX_LED_COUNT; i++) light[i] = qsub8(light[i], 5);
+        for (uint8_t col = 0; col < MATRIX_COLS; col++) {
+            if (!head[col]) {
+                if (random8() < 6) head[col] = 15;   /* the next step enters the top row */
+                continue;
+            }
+            uint8_t was = head[col] >> 4;
+            head[col] += step;
+            uint8_t now = head[col] >> 4;
+            if (now == was) continue;
+            if (now > MATRIX_ROWS) {
+                head[col] = 0;
+                continue;
+            }
+            uint8_t led = g_led_config.matrix_co[now - 1][col];
+            if (led != NO_LED) light[led] = 255;
+        }
+    }
+
+    rgb_t   c    = rgb_matrix_hsv_to_rgb(rgb_matrix_config.hsv);
+    uint8_t full = fx_level();
+    for (uint8_t i = led_min; i < led_max; i++) {
+        RGB_MATRIX_TEST_LED_FLAGS();
+        if (light[i] > 235) {
+            rgb_matrix_set_color(i, full, full, full);
+        } else {
+            fx_set(i, c, light[i]);
+        }
+    }
+    return rgb_matrix_check_finished_leds(led_max);
+}
+
+#endif // RGB_MATRIX_CUSTOM_EFFECT_IMPLS
+
+/* FIRE -- heat rises from the bottom row: each cell takes the mix of the three
+ * under it, less a random cooling, on the matrix grid. */
+RGB_MATRIX_EFFECT(FIRE)
+
+#ifdef RGB_MATRIX_CUSTOM_EFFECT_IMPLS
+
+_Static_assert(MATRIX_ROWS * MATRIX_COLS <= sizeof(fx_mem), "the fire's grid must fit fx_mem");
+
+static bool FIRE(effect_params_t* params) {
+    static uint8_t wait = 0;
+    uint8_t (*heat)[MATRIX_COLS] = (uint8_t (*)[MATRIX_COLS])fx_mem;
+
+    fx_start(params);
+    RGB_MATRIX_USE_LIMITS(led_min, led_max);
+
+    if (params->iter == 0 && !wait--) {
+        wait = 3 - (rgb_matrix_config.speed >> 6);
+        for (uint8_t col = 0; col < MATRIX_COLS; col++) heat[MATRIX_ROWS - 1][col] = random8_min_max(130, 235);
+        for (uint8_t row = 0; row + 1 < MATRIX_ROWS; row++) {
+            for (uint8_t col = 0; col < MATRIX_COLS; col++) {
+                uint8_t  left  = col ? col - 1 : col;
+                uint8_t  right = col + 1 < MATRIX_COLS ? col + 1 : col;
+                uint16_t mix   = heat[row + 1][left] + 2u * heat[row + 1][col] + heat[row + 1][right];
+                heat[row][col] = qsub8((uint8_t)(mix >> 2), random8_max(40));
+            }
+        }
+    }
+
+    uint8_t full = fx_level();
+    for (uint8_t row = 0; row < MATRIX_ROWS; row++) {
+        for (uint8_t col = 0; col < MATRIX_COLS; col++) {
+            uint8_t i = g_led_config.matrix_co[row][col];
+            if (i == NO_LED || i < led_min || i >= led_max) continue;
+            if (!HAS_ANY_FLAGS(g_led_config.flags[i], params->flags)) continue;
+            uint8_t t = heat[row][col];   /* black, red, yellow, white */
+            uint8_t r = t < 85 ? t * 3 : 255;
+            uint8_t g = t < 85 ? 0 : t < 170 ? (t - 85) * 3 : 255;
+            uint8_t b = t < 170 ? 0 : (t - 170) * 3;
+            rgb_matrix_set_color(i, scale8(r, full), scale8(g, full), scale8(b, full));
+        }
+    }
+    return rgb_matrix_check_finished_leds(led_max);
+}
+
+#endif // RGB_MATRIX_CUSTOM_EFFECT_IMPLS
+
+/* SPIRAL -- a rainbow turning around the middle of the board. */
+RGB_MATRIX_EFFECT(SPIRAL)
+
+#ifdef RGB_MATRIX_CUSTOM_EFFECT_IMPLS
+
+static bool SPIRAL(effect_params_t* params) {
+    RGB_MATRIX_USE_LIMITS(led_min, led_max);
+    uint8_t time = (uint8_t)rgb_speed_phase(g_rgb_timer, rgb_speed_rate(&RGB_SPEED_CYCLE_SWEEP, rgb_matrix_config.speed));
+    for (uint8_t i = led_min; i < led_max; i++) {
+        RGB_MATRIX_TEST_LED_FLAGS();
+        int16_t dx = (int16_t)g_led_config.point[i].x - k_rgb_matrix_center.x;
+        int16_t dy = (int16_t)g_led_config.point[i].y - k_rgb_matrix_center.y;
+        uint8_t d  = sqrt16((uint16_t)(dx * dx + dy * dy));
+        hsv_t   hsv = {(uint8_t)(atan2_8(dy, dx) + d * 2 - time), 255, rgb_matrix_config.hsv.v};
+        rgb_t   c   = rgb_matrix_hsv_to_rgb(hsv);
+        rgb_matrix_set_color(i, c.r, c.g, c.b);
+    }
+    return rgb_matrix_check_finished_leds(led_max);
+}
+
+#endif // RGB_MATRIX_CUSTOM_EFFECT_IMPLS
+
+/* HOST_COLORS -- every key shows the color the computer sent for it.
+ *
+ * The buffer is filled by the raw-HID channel 0x14 (hid_protocol.c); this only
+ * paints it, scaled by the board's brightness. If the host goes quiet for 2 s
+ * host_colors_housekeeping() brings back the saved effect, so wireless use and a
+ * closed program behave like any other effect. Dark is only that brief moment.
+ * The last mode: nothing else moves when it comes and goes, and the keyboard's
+ * own step wraps past it to the first.
+ */
+RGB_MATRIX_EFFECT(HOST_COLORS)
+
+#ifdef RGB_MATRIX_CUSTOM_EFFECT_IMPLS
+
+extern uint8_t  host_colors[RGB_MATRIX_LED_COUNT][3];
+extern uint32_t host_colors_at;
+
+static bool HOST_COLORS(effect_params_t* params) {
+    RGB_MATRIX_USE_LIMITS(led_min, led_max);
+    bool    alive = timer_elapsed32(host_colors_at) < 2000;
+    uint8_t v     = rgb_matrix_config.hsv.v;
+    for (uint8_t i = led_min; i < led_max; i++) {
+        RGB_MATRIX_TEST_LED_FLAGS();
+        if (alive) {
+            rgb_matrix_set_color(i, scale8(host_colors[i][0], v), scale8(host_colors[i][1], v), scale8(host_colors[i][2], v));
+        } else {
+            rgb_matrix_set_color(i, 0, 0, 0);
+        }
+    }
+    return rgb_matrix_check_finished_leds(led_max);
+}
+
+#endif // RGB_MATRIX_CUSTOM_EFFECT_IMPLS
