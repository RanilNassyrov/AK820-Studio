+// ---------------------------------------------------------------------------
+// Host colors channel: every key's color, sent by the computer for the
+// HOST_COLORS effect (rgb_matrix_kb.inc). No flash is touched.
+//   [SET_VALUE, HOST_COLORS_CHANNEL, first LED, count, r, g, b, r, g, b, ...]
+// A 32-byte report carries 9 LEDs. A bad range is refused, not clamped.
+enum { HOST_COLORS_CHANNEL = 0x14, HOST_COLORS_PER_PACKET = 9 };
+
+uint8_t  host_colors[RGB_MATRIX_LED_COUNT][3];
+uint32_t host_colors_at;
+
+static inline bool is_host_colors_cmd(const uint8_t *data, uint8_t length) {
+    return length >= 4 && data[0] == RTC_SET_VALUE && data[1] == HOST_COLORS_CHANNEL;
+}
+
+static void host_colors_command(uint8_t *data, uint8_t length) {
+    uint8_t first = data[2], count = data[3];
+    if (count == 0 || count > HOST_COLORS_PER_PACKET ||
+        (uint16_t)first + count > RGB_MATRIX_LED_COUNT ||
+        length < (uint16_t)4 + (uint16_t)count * 3) {
+        data[0] = RTC_UNHANDLED;
+        return;
+    }
+    memcpy(host_colors[first], &data[4], (uint16_t)count * 3);
+    host_colors_at = timer_read32();
+}
+
