+// ---------------------------------------------------------------------------
+// Host colors channel: every key's color, sent by the computer for the
+// HOST_COLORS effect (rgb_matrix_kb.inc). No flash is touched.
+//   [SET_VALUE, HOST_COLORS_CHANNEL, first LED, count, r, g, b, r, g, b, ...]
+// A 32-byte report carries 9 LEDs. A bad range is refused, not clamped.
+enum { HOST_COLORS_CHANNEL = 0x14, HOST_COLORS_PER_PACKET = 9 };
+
+uint8_t  host_colors[RGB_MATRIX_LED_COUNT][3];
+uint32_t host_colors_at;
+
+static inline bool is_host_colors_cmd(const uint8_t *data, uint8_t length) {
+    return length >= 4 && data[0] == RTC_SET_VALUE && data[1] == HOST_COLORS_CHANNEL;
+}
+
+static void host_colors_command(uint8_t *data, uint8_t length) {
+    uint8_t first = data[2], count = data[3];
+    if (count == 0 || count > HOST_COLORS_PER_PACKET ||
+        (uint16_t)first + count > RGB_MATRIX_LED_COUNT ||
+        length < (uint16_t)4 + (uint16_t)count * 3) {
+        data[0] = RTC_UNHANDLED;
+        return;
+    }
+    memcpy(host_colors[first], &data[4], (uint16_t)count * 3);
+    host_colors_at = timer_read32();
+}
+
+/* No program, no cable, or a sleeping computer: the keyboard must not stay dark
+ * or frozen, so it returns to the effect saved in its memory. The host sends a
+ * frame BEFORE it selects the effect, or this would undo the selection at once.
+ * A saved HOST_COLORS is replaced: reloading it would only come back here.
+ * Long past the 2 s, no frames were coming at all: the Fn key stepped in from
+ * the last effect, and this is the last mode, so the step wraps to the first. */
+void host_colors_housekeeping(void) {
+    if (rgb_matrix_get_mode() != RGB_MATRIX_CUSTOM_HOST_COLORS) return;
+    uint32_t quiet = timer_elapsed32(host_colors_at);
+    if (quiet < 2000) return;
+    if (quiet >= 2500) {
+        rgb_matrix_mode(RGB_MATRIX_SOLID_COLOR);
+        return;
+    }
+    rgb_matrix_reload_from_eeprom();
+    if (rgb_matrix_get_mode() == RGB_MATRIX_CUSTOM_HOST_COLORS) rgb_matrix_mode_noeeprom(RGB_MATRIX_CYCLE_ALL);
+}
+
+// ---------------------------------------------------------------------------
+// Key colors channel: the keys' real colors for the program's picture, and the
+// KEY_COLORS effect's palette, which stays on the keyboard for wireless use.
+//   [SET_VALUE, KEY_COLORS_CHANNEL, KC_LED_READ, first] -> [.., .., .., first, 9 LEDs]
+//   [SET_VALUE, KEY_COLORS_CHANNEL, KC_PAL_SET, first, count, r, g, b, ...]
+//   [SET_VALUE, KEY_COLORS_CHANNEL, KC_PAL_SAVE] -> data[3]: 1 while a GIF plays
+// The palette lives in one external-flash sector of our own region. It is too
+// big for the emulated EEPROM, whose writes also blink the LEDs. A save erases
+// and programs in steps from housekeeping, so it never stalls a key scan, and a
+// playing GIF, which owns that bus, only delays it.
+enum {
+    KEY_COLORS_CHANNEL = 0x15,
+    KC_LED_READ = 1, KC_PAL_SET = 2, KC_PAL_SAVE = 3,
+    KC_PER_PACKET = 9,
+};
+#define KEY_PALETTE_ADDR 0xFF0000u
+static const uint8_t key_palette_magic[4] = {'A', 'K', 'P', '1'};
+
+uint8_t         key_palette[RGB_MATRIX_LED_COUNT][3];
+static bool     key_palette_ready = false;
+static uint8_t  key_palette_step  = 0;   /* 0 idle, then erase, palette, magic: the magic last, so a cut save reads as none */
+
+static inline bool is_key_colors_cmd(const uint8_t *data, uint8_t length) {
+    return length >= 4 && data[0] == RTC_SET_VALUE && data[1] == KEY_COLORS_CHANNEL;
+}
+
+static void key_colors_command(uint8_t *data, uint8_t length) {
+    uint8_t first = data[3];
+    switch (data[2]) {
+        case KC_LED_READ:
+            if (first >= RGB_MATRIX_LED_COUNT) break;
+            for (uint8_t i = 0; i < KC_PER_PACKET && first + i < RGB_MATRIX_LED_COUNT; i++) {
+                sn32f2xx_get_color(first + i, &data[4 + i * 3]);
+            }
+            return;
+        case KC_PAL_SET: {
+            uint8_t count = data[4];
+            if (count == 0 || count > KC_PER_PACKET || (uint16_t)first + count > RGB_MATRIX_LED_COUNT ||
+                length < (uint16_t)5 + (uint16_t)count * 3) {
+                break;
+            }
+            memcpy(key_palette[first], &data[5], (uint16_t)count * 3);
+            key_palette_ready = true;
+            return;
+        }
+        case KC_PAL_SAVE:
+            key_palette_step = 1;
+            data[3]          = anim_active() ? 1 : 0;
+            return;
+    }
+    data[0] = RTC_UNHANDLED;
+}
+
+static void key_palette_load(void) {
+    uint8_t magic[sizeof key_palette_magic];
+    flash_read_bytes(KEY_PALETTE_ADDR, magic, sizeof magic);
+    if (memcmp(magic, key_palette_magic, sizeof magic) == 0) {
+        flash_read_bytes(KEY_PALETTE_ADDR + sizeof magic, &key_palette[0][0], sizeof key_palette);
+        return;
+    }
+    for (uint8_t i = 0; i < RGB_MATRIX_LED_COUNT; i++) {   /* nothing saved yet: letters and modifiers apart */
+        bool mod          = HAS_FLAGS(g_led_config.flags[i], LED_FLAG_MODIFIER);
+        key_palette[i][0] = mod ? 170 : 0;
+        key_palette[i][1] = mod ? 0 : 220;
+        key_palette[i][2] = 255;
+    }
+}
+
+void key_palette_housekeeping(void) {
+    if (!key_palette_ready) {
+        /* After boot, once the display owns a ready bus. */
+        if (timer_read32() < 1000 || anim_active()) return;
+        key_palette_load();
+        key_palette_ready = true;
+        return;
+    }
+    if (!key_palette_step || anim_active() || flash_busy()) return;
+    if (key_palette_step == 1) {
+        if (flash_erase_sector(KEY_PALETTE_ADDR)) key_palette_step = 2;
+    } else if (key_palette_step == 2) {
+        if (flash_page_program(KEY_PALETTE_ADDR + sizeof key_palette_magic, &key_palette[0][0], sizeof key_palette)) key_palette_step = 3;
+    } else if (flash_page_program(KEY_PALETTE_ADDR, key_palette_magic, sizeof key_palette_magic)) {
+        key_palette_step = 0;
+    }
+}
+_Static_assert(sizeof key_palette + sizeof key_palette_magic <= 256, "the palette must fit one flash page");
+
